# ── Track resolution ────────────────────────────────────────────────────────
# Production resolves the track from the request host (subdomain CNAME pattern):
#   cashflow.ekantikcapital.com  → ecfs   (public · futures)
#   alpha.ekantikcapital.com     → alpha  (public · publisher)
#   epig500.ekantikcapital.com   → epig   (gated  · advisory)
# Locally, append ?track=ecfs|alpha|epig to preview any surface on localhost.

# ── Supabase (Phase 2 — swap the typed seed for live data) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Zoom Server-to-Server OAuth (Phase 2 native registration, §4) ────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── HubSpot (capture + nurture; three ISOLATED streams, §5) ──────────────────
HUBSPOT_TOKEN=
HUBSPOT_LIST_ECFS=
HUBSPOT_LIST_ALPHA=
HUBSPOT_LIST_EPIG=
